{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/text-lint.py\"",
            "statusMessage": "Text-Lint"
          }
        ]
      }
    ]
  }
}
